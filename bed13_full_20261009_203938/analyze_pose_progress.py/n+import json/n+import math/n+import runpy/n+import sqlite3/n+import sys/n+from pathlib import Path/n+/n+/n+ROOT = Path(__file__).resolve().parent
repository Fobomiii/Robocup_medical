TOOLS = ROOT.parent / "bed13_full_20261009_012734" / "analyze_runs.py"
sys.argv = [str(TOOLS), str(ROOT)]
namespace = runpy.run_path(str(TOOLS), run_name="bed13_tools")
CdrReader = namespace["CdrReader"]

connection = sqlite3.connect(
    f"file:{(ROOT / 'rosbag' / 'rosbag_0.db3').as_posix()}?mode=ro",
    uri=True,
)
rows = connection.execute(
    """
    SELECT m.timestamp, m.data
    FROM messages m JOIN topics t ON t.id = m.topic_id
    WHERE t.name = ? ORDER BY m.timestamp
    """,
    ("/medical_nav/robot_pose",),
).fetchall()
poses = []
for timestamp, data in rows:
    pose = CdrReader(data).pose_stamped()
    poses.append((timestamp / 1.0e9, pose[0], pose[1]))

start = 1791549593.243888181
result = []
for second in range(13):
    sample = min(poses, key=lambda item: abs(item[0] - (start + second)))
    result.append(
        {
            "sec": second,
            "t": round(sample[0] - start, 3),
            "x": round(sample[1], 3),
            "y": round(sample[2], 3),
            "goal_distance_m": round(
                math.hypot(5.4 - sample[1], -2.2 - sample[2]), 3
            ),
        }
    )
print(json.dumps(result, ensure_ascii=False))
