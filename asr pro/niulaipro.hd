<xml xmlns="http://www.w3.org/1999/xhtml"><block type="setup" id="medical_setup" x="0" y="0"><statement name="DO"><block type="block_with_textarea" id="setup_note"><field name="input">// 医疗送药车语音模块：串口0为PB5(TX)、PB6(RX)，9600 8N1</field><next><block type="asr_speak" id="voice_settings"><field name="VOICE_SET">小蝶-清新女声</field><field name="vol">10</field><field name="speed">10</field><next><block type="asr_event_play_audio" id="Lie]c~]pgw|0${G`0$EQ"><field name="audio">1</field></block></next></block></next></block></statement></block><block type="asr_welcom" id="power_on_audio" x="171" y="158"><field name="NAME">牛奶来啦</field></block><block type="asr_sleep" id="sleep_audio" x="174" y="224"><field name="NAME"></field></block><block type="hardware_init" id="medical_hardware_init" x="0" y="300"><statement name="DO"><block type="block_with_textarea" id="hardware_note"><field name="input">// 串口接收事件会自动初始化Serial为9600 8N1</field><next><block type="vol_set" id="playback_volume"><value name="num"><shadow type="asr_vol" id="playback_volume_value"><field name="PIN">7</field></shadow></value></block></next></block></statement></block><block type="myasr_serial_readstring_hex" id="bed1_serial_event" x="0" y="500"><field name="serial_select">Serial</field><field name="NAME">AA 55 01 FE</field><statement name="DO"><block type="enter_wakeup" id="bed1_enter_wakeup"><value name="num"><shadow type="math_number" id="bed1_wakeup_seconds"><field name="NUM">10</field></shadow></value><next><block type="asr_event_play_audio" id="bed1_play_audio"><field name="audio">1床病人请取药</field></block></next></block></statement></block><block type="myasr_serial_readstring_hex" id="bed3_serial_event" x="0" y="680"><field name="serial_select">Serial</field><field name="NAME">AA 55 03 FC</field><statement name="DO"><block type="enter_wakeup" id="bed3_enter_wakeup"><value name="num"><shadow type="math_number" id="bed3_wakeup_seconds"><field name="NUM">10</field></shadow></value><next><block type="asr_event_play_audio" id="bed3_play_audio"><field name="audio">3床病人请取药</field></block></next></block></statement></block><block type="procedures_defnoreturn" id="asr_code_hook" x="0" y="860"><field name="NAME">ASR_CODE</field><comment pinned="false" h="80" w="160">语音识别成功钩子；本项目由STM32串口触发播报。</comment><statement name="STACK"><block type="set_state_enter_wakeup" id="keep_wakeup"><value name="num"><shadow type="math_number" id="keep_wakeup_seconds"><field name="NUM">10</field></shadow></value></block></statement></block></xml>
