<xml xmlns="http://www.w3.org/1999/xhtml">
  <block type="setup" id="medical_setup" x="0" y="0">
    <statement name="DO">
      <block type="block_with_textarea" id="setup_note">
        <field name="input">// 医疗送药车语音模块：PB5(TX)、PB6(RX)，9600 8N1；上电保持静音，仅响应STM32串口命令</field>
        <next>
          <block type="asr_speak" id="voice_settings">
            <field name="VOICE_SET">小爱-活泼女声(V3)</field>
            <field name="vol">10</field>
            <field name="speed">10</field>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="hardware_init" id="medical_hardware_init" x="0" y="220">
    <statement name="DO">
      <block type="block_with_textarea" id="hardware_note">
        <field name="input">// 永久暂停离线语音识别；不影响串口命令触发音频播放
asrtop_asr_system_pause();</field>
        <next>
          <block type="vol_set" id="playback_volume">
            <value name="num">
              <shadow type="asr_vol" id="playback_volume_value">
                <field name="PIN">7</field>
              </shadow>
            </value>
          </block>
        </next>
      </block>
    </statement>
  </block>
  <block type="myasr_serial_readstring_hex" id="bed1_serial_event" x="0" y="440">
    <field name="serial_select">Serial</field>
    <field name="NAME">AA 55 01 FE</field>
    <statement name="DO">
      <block type="asr_event_play_audio" id="bed1_play_audio">
        <field name="audio">1床病人请取药</field>
      </block>
    </statement>
  </block>
  <block type="myasr_serial_readstring_hex" id="bed3_serial_event" x="0" y="620">
    <field name="serial_select">Serial</field>
    <field name="NAME">AA 55 03 FC</field>
    <statement name="DO">
      <block type="asr_event_play_audio" id="bed3_play_audio">
        <field name="audio">3床病人请取药</field>
      </block>
    </statement>
  </block>
  <block type="procedures_defnoreturn" id="asr_code_hook" x="0" y="800">
    <field name="NAME">ASR_CODE</field>
    <comment pinned="false" h="80" w="200">保留空回调以满足SDK接口；不启用语音唤醒。</comment>
  </block>
</xml>
