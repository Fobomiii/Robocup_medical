Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RobotModel1
        - /Mid360 PointCloud1
    Tree Height: 650
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground Grid
      Enabled: true
      Alpha: 0.5
      Cell Size: 1
      Color: 100; 110; 120
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Map
      Name: Static Map
      Enabled: true
      Alpha: 0.65
      Draw Behind: true
      Topic:
        Value: /map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: true
      Alpha: 0.45
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Value: /global_costmap/costmap
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Update Topic:
        Value: /global_costmap/costmap_updates
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: false
      Alpha: 0.65
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Value: /local_costmap/costmap
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Update Topic:
        Value: /local_costmap/costmap_updates
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
    - Class: rviz_default_plugins/PointCloud2
      Name: Mid360 Filtered PointCloud
      Enabled: false
      Topic:
        Value: /livox/lidar_filtered
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (Pixels): 2
      Size (m): 0.01
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0.2
      Selectable: true
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Mid360 Raw PointCloud
      Enabled: false
      Topic:
        Value: /livox/lidar
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (Pixels): 2
      Size (m): 0.01
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0.2
      Selectable: true
      Use Fixed Frame: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.35
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/Axes
      Name: Map Axes
      Enabled: true
      Reference Frame: map
      Length: 1.0
      Radius: 0.025
    - Class: rviz_default_plugins/Axes
      Name: Robot Body Axes
      Enabled: true
      Reference Frame: base_link
      Length: 0.6
      Radius: 0.025
    - Class: rviz_default_plugins/Path
      Name: Nav2 Plan
      Enabled: true
      Topic:
        Value: /medical_nav/plan
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 10
      Line Style: Lines
      Line Width: 0.05
      Color: 255; 120; 0
    - Class: rviz_default_plugins/Pose
      Name: OPS9-HWT Pose
      Enabled: true
      Topic:
        Value: /medical_nav/robot_pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
      Shape: Arrow
      Color: 30; 220; 120
      Shaft Length: 0.5
      Shaft Radius: 0.05
      Head Length: 0.2
      Head Radius: 0.10
  Enabled: true
  Global Options:
    Background Color: 24; 28; 32
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: nav2_rviz_plugins/GoalTool
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: 3D Orbit
      Distance: 10
      Focal Point:
        X: 3
        Y: 0
        Z: 0
      Pitch: 0.65
      Yaw: 1.0
      Target Frame: map
      Near Clip Distance: 0.01
      Invert Z Axis: false
Window Geometry:
  Height: 1000
  Width: 1700
  X: 0
  Y: 0
  Hide Left Dock: false
  Hide Right Dock: false
