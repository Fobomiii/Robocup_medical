[Unit]
Description=Medical Navigation Bridge
After=network.target mid360.service
Wants=mid360.service

[Service]
Type=simple
User=fzurobot
Environment=HOME=/home/fzurobot
Environment=MEDICAL_NAV_DRY_RUN=false
Environment=ROS_DOMAIN_ID=77
Environment=ROS_LOCALHOST_ONLY=1
EnvironmentFile=-/home/fzurobot/.config/medical-navigation.env
ExecStartPre=/bin/sleep 5
ExecStart=/bin/bash /home/fzurobot/start_obstacle.sh /dev/medical_stm32
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
