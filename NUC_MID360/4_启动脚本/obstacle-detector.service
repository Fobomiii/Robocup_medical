[Unit]
Description=Medical Navigation Bridge
After=network.target mid360.service
Wants=mid360.service

[Service]
Type=simple
User=gp-pcie
Environment=HOME=/home/gp-pcie
Environment=MEDICAL_NAV_DRY_RUN=false
EnvironmentFile=-/home/gp-pcie/.config/medical-navigation.env
ExecStartPre=/bin/sleep 5
ExecStart=/bin/bash /home/gp-pcie/start_obstacle.sh /dev/ttyUSB0
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
