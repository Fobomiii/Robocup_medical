<!--
  Fast nurse-station scan navigation. A blocked scan viewpoint gets one
  costmap clear and then returns failure so the navigator can immediately try
  the next center/left/right viewpoint. Smooth each new plan before following;
  keep that same new plan if smoothing fails. Contains no chassis
  recovery motion such as Spin, Wait or BackUp.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <PipelineSequence name="NavigateNurseScanViewpoint">
      <RateController hz="2.0">
        <RecoveryNode number_of_retries="1" name="ComputeAndSmoothNurseScanPath">
          <Sequence name="PlanThenSmoothNurseScanPath">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <Fallback name="SmoothOrKeepOriginal">
              <SmoothPath unsmoothed_path="{path}" smoothed_path="{path}" smoother_id="constrained_smoother" max_smoothing_duration="0.45" check_for_collisions="true"/>
              <AlwaysSuccess/>
            </Fallback>
          </Sequence>
          <ClearEntireCostmap name="ClearGlobalCostmap-NurseScan" service_name="global_costmap/clear_entirely_global_costmap"/>
        </RecoveryNode>
      </RateController>
      <RecoveryNode number_of_retries="1" name="FollowNurseScanPath">
        <FollowPath path="{path}" controller_id="FollowPathDWB"/>
        <ClearEntireCostmap name="ClearLocalCostmap-NurseScan" service_name="local_costmap/clear_entirely_local_costmap"/>
      </RecoveryNode>
    </PipelineSequence>
  </BehaviorTree>
</root>
