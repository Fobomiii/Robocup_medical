static uint8_t i2c_addr8(void)
{
  return (uint8_t)(SSD1306_I2C_ADDR << 1);
}

static uint8_t write_cmd(uint8_t cmd)
{
  uint8_t buf[2] = {0x00u, cmd};
  return (HAL_I2C_Master_Transmit(&hi2c2, i2c_addr8(), buf, 2u, SSD1306_I2C_TIMEOUT_MS) == HAL_OK) ? 1u : 0u;
}

static uint8_t write_data(const uint8_t *data, uint16_t len)
{
  static uint8_t tx[SSD1306_WIDTH + 1u];

  if (len > SSD1306_WIDTH)
  {
    return 0u;
  }

  tx[0] = 0x40u;
  memcpy(&tx[1], data, len);
  return (HAL_I2C_Master_Transmit(&hi2c2, i2c_addr8(), tx, (uint16_t)(len + 1u), SSD1306_I2C_TIMEOUT_MS) == HAL_OK) ? 1u : 0u;
}

static uint8_t send_init_sequence(void)
{
  static const uint8_t init_common[] = {
    0xAE,       /* display off */
    0xD5, 0x80, /* clock div */
    0xA8, SSD1306_MUX_RATIO,
    0xD3, 0x00, /* display offset */
    0x40,       /* start line */
    0x8D, 0x14, /* charge pump on */
    0x20, 0x02, /* page addressing (与 ssd1306_display 一致) */
    0xA1,       /* segment remap */
    0xC8,       /* com scan dec */
    0xDA, SSD1306_COM_PINS,
    0x81, 0xCF, /* contrast */
    0xD9, 0xF1, /* pre-charge */
    0xDB, 0x40, /* vcomh */
    0xA4,       /* display from RAM */
    0xA6,       /* normal display */
    0xAF        /* display on */
  };
  uint8_t i;

  for (i = 0u; i < sizeof(init_common); i++)
  {
    if (write_cmd(init_common[i]) == 0u)
    {
      return 0u;
    }
  }
  return 1u;
}

uint8_t ssd1306_begin(void)
{
  if (HAL_I2C_IsDeviceReady(&hi2c2, i2c_addr8(), 3u, SSD1306_I2C_TIMEOUT_MS) != HAL_OK)
  {
    return 0u;
  }

  if (send_init_sequence() == 0u)
  {
    return 0u;
  }

  ssd1306_clearDisplay();
  ssd1306_setCursor(0, 0);
  ssd1306_setTextSize(1u);
  ssd1306_setTextColor(SSD1306_WHITE);
  ssd1306_display();
  return 1u;
}

void ssd1306_clearDisplay(void)
{
  memset(s_buffer, 0, sizeof(s_buffer));
}

void ssd1306_display(void)
{
  uint8_t page;

  for (page = 0u; page < SSD1306_PAGES; page++)
  {
    if (write_cmd((uint8_t)(0xB0u + page)) == 0u)
    {
      return;
    }
    if (write_cmd(0x00u) == 0u)
    {
      return;
    }
    if (write_cmd(0x10u) == 0u)
    {
      return;
    }
    (void)write_data(&s_buffer[(uint16_t)page * SSD1306_WIDTH], SSD1306_WIDTH);
  }
}

void ssd1306_invertDisplay(uint8_t inv)
{
  (void)write_cmd(inv ? 0xA7u : 0xA6u);
}

void ssd1306_setCursor(int16_t x, int16_t y)
{
  s_cursor_x = x;
  s_cursor_y = y;
}

void ssd1306_setTextSize(uint8_t size)
{
  if (size < 1u)
  {
    size = 1u;
  }
  s_text_size = size;
}

void ssd1306_setTextColor(uint16_t color)
{
  s_text_color = color;
}

void ssd1306_drawPixel(int16_t x, int16_t y, uint16_t color)
{
  uint16_t idx;
  uint8_t mask;

  if (x < 0 || y < 0 || x >= (int16_t)SSD1306_WIDTH || y >= (int16_t)SSD1306_HEIGHT)
  {
    return;
  }

  idx = (uint16_t)x + ((uint16_t)(y / 8) * SSD1306_WIDTH);
  mask = (uint8_t)(1u << (y & 7));

  switch (color)
  {
    case SSD1306_WHITE:
      s_buffer[idx] |= mask;
      break;
    case SSD1306_BLACK:
      s_buffer[idx] &= (uint8_t)(~mask);
      break;
    case SSD1306_INVERSE:
    default:
      s_buffer[idx] ^= mask;
      break;
  }
}

static void draw_char(int16_t x, int16_t y, char c, uint16_t color, uint8_t size)
{
  uint8_t i;
  uint8_t j;
  int16_t px;
  int16_t py;
  uint8_t line;
  const uint8_t *glyph;

  if (c < ' ' || c > '~')
  {
    c = '?';
  }

  glyph = &s_font5x7[(uint8_t)(c - ' ') * 5u];

  for (i = 0u; i < 5u; i++)
  {
    line = glyph[i];
    for (j = 0u; j < 8u; j++)
    {
      if ((line & (1u << j)) != 0u)
      {
        for (py = 0; py < (int16_t)size; py++)
        {
          for (px = 0; px < (int16_t)size; px++)
          {
            ssd1306_drawPixel((int16_t)(x + (int16_t)i * (int16_t)size + px),
                              (int16_t)(y + (int16_t)j * (int16_t)size + py),
                              color);
          }
        }
      }
    }
  }
}

void ssd1306_drawLine(int16_t x0, int16_t y0, int16_t x1, int16_t y1, uint16_t color)
{
  int16_t dx = (x1 >= x0) ? (x1 - x0) : (x0 - x1);
  int16_t sx = (x0 < x1) ? 1 : -1;
  int16_t dy = (y1 >= y0) ? (y0 - y1) : (y1 - y0);
  int16_t sy = (y0 < y1) ? 1 : -1;
  int16_t err = dx + dy;

  for (;;)
  {
    ssd1306_drawPixel(x0, y0, color);
    if (x0 == x1 && y0 == y1)
    {
      break;
    }
    {
      int16_t e2 = err * 2;
      if (e2 >= dy)
      {
        err += dy;
        x0 += sx;
      }
      if (e2 <= dx)
      {
        err += dx;
        y0 += sy;
      }
    }
  }
}

void ssd1306_drawRect(int16_t x, int16_t y, int16_t w, int16_t h, uint16_t color)
{
  ssd1306_drawLine(x, y, (int16_t)(x + w - 1), y, color);
  ssd1306_drawLine(x, (int16_t)(y + h - 1), (int16_t)(x + w - 1), (int16_t)(y + h - 1), color);
  ssd1306_drawLine(x, y, x, (int16_t)(y + h - 1), color);
  ssd1306_drawLine((int16_t)(x + w - 1), y, (int16_t)(x + w - 1), (int16_t)(y + h - 1), color);
}

void ssd1306_fillRect(int16_t x, int16_t y, int16_t w, int16_t h, uint16_t color)
{
  int16_t i;
  int16_t j;

  for (j = 0; j < h; j++)
  {
    for (i = 0; i < w; i++)
    {
      ssd1306_drawPixel((int16_t)(x + i), (int16_t)(y + j), color);
    }
  }
}

void ssd1306_print(const char *s)
{
  uint8_t char_w = (uint8_t)(6u * s_text_size);

  while (s != NULL && *s != '\0')
  {
    if (*s == '\n')
    {
      s_cursor_y = (int16_t)(s_cursor_y + (int16_t)(8 * s_text_size));
      s_cursor_x = 0;
    }
    else
    {
      if ((s_cursor_x + (int16_t)(5 * s_text_size)) > (int16_t)SSD1306_WIDTH)
      {
        s_cursor_x = 0;
        s_cursor_y = (int16_t)(s_cursor_y + (int16_t)(8 * s_text_size));
      }
      if ((s_cursor_y + (int16_t)(8 * s_text_size)) > (int16_t)SSD1306_HEIGHT)
      {
        break;
      }
      draw_char(s_cursor_x, s_cursor_y, *s, s_text_color, s_text_size);
      s_cursor_x = (int16_t)(s_cursor_x + char_w);
    }
    s++;
  }
}

void ssd1306_println(const char *s)
{
  ssd1306_print(s);
  s_cursor_y = (int16_t)(s_cursor_y + (int16_t)(8 * s_text_size));
  s_cursor_x = 0;
}

int ssd1306_printf(const char *fmt, ...)
{
  char buf[64];
  va_list args;
  int n;

  va_start(args, fmt);
  n = vsnprintf(buf, sizeof(buf), fmt, args);
  va_end(args);

  if (n > 0)
  {
    ssd1306_print(buf);
  }
  return n;
}
